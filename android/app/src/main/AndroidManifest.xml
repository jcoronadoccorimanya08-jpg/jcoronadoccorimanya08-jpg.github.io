<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solo para el recordatorio de las 22:30 (sin internet): mostrar la notificación a su hora
         y volver a programarla si reinicias el teléfono. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_valq"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rachas">

        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- Val Q: abre la app web a pantalla completa (Trusted Web Activity) y recibe el resumen para el widget. -->
        <activity
            android:name=".ValQActivity"
            android:exported="true"
            android:icon="@mipmap/ic_valq"
            android:label="Val Q"
            android:launchMode="singleTask"
            android:taskAffinity=".valq"
            android:theme="@style/Theme.Rachas.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BitacoraActivity"
            android:exported="true"
            android:icon="@mipmap/ic_bitacora"
            android:label="Bitácora"
            android:launchMode="singleTask"
            android:taskAffinity=".bitacora"
            android:theme="@style/Theme.Rachas.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Chrome se conecta aquí para entregar lo que manda la app web (sin esto, el widget no recibe nada). -->
        <service
            android:name="androidx.browser.customtabs.PostMessageService"
            android:exported="true" />

        <!-- Cambia el widget de día a medianoche, lo despierta a las 21:00 y lanza el recordatorio de las 22:30. -->
        <receiver
            android:name=".TickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ValQWidget"
            android:exported="false"
            android:label="@string/widget_valq">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_OPTIONS_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_valq_info" />
        </receiver>

        <receiver
            android:name=".BitacoraWidget"
            android:exported="false"
            android:label="@string/widget_bitacora">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_OPTIONS_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bitacora_info" />
        </receiver>
    </application>
</manifest>
